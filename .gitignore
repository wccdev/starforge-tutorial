# ============ 训练产物 / 大文件（绝不入库）============
# checkpoint / 权重
outputs/
output/
results/
checkpoints/
ckpt/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.nemo
*.gguf
hf_export/
exported_model/
# scripts/download_models.py 的落盘目录（待同步到算力机的 HF 缓存），hf_models 是旧版平铺布局
hf_cache/
hf_models/

# 数据（只入库元数据与处理脚本，原始/大数据本地或对象存储）
datasets/**/raw/
datasets/**/data/
data/raw/
*.arrow
*.parquet
*.jsonl.gz
# 若数据集较小需入库，删除对应忽略行或用 git-lfs

# 题库为公司内部专有数据，整目录不入库（含原始 raw 与处理后的 jsonl）
datasets/qa_rl/

# OPSD 训练数据：带完整参考解，8000 条就有几十 MB、全量上百 MB。
# 不入库之外还有一层原因：sf submit 打包用的是
# `git ls-files --cached --others --exclude-standard`，**未被忽略的未跟踪文件也会上传**，
# 不忽略就等于每次提交都把这几十 MB 重传一遍。数据本来就常驻集群
# /data/datasets/opsd_math，随包上传纯属浪费。
datasets/opsd_math/*.jsonl

# 日志（SwanLab 本地缓存 / 其他 tracker）
swanlog/
swanlab/
wandb/
mlruns/
logs/
*.log
tensorboard/
events.out.tfevents.*

# Ray / 分布式临时文件
ray_results/
/tmp/ray/
*.pid

# 本地 run 台账（sf submit 追加；含 IP/用户，仅本地追溯用）
.forge/

